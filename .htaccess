# ═══════════════════════════════════════════════════════════
#  GLORIKAR — root .htaccess (production reference)
# ═══════════════════════════════════════════════════════════

Options -Indexes
ServerSignature Off

# Never serve sensitive / internal files directly
<FilesMatch "\.(env|sql|log|json|md|gitignore|lock)$">
  Require all denied
</FilesMatch>

<FilesMatch "composer\.(json|lock)$">
  Require all denied
</FilesMatch>

# Allow the PWA manifest (must come AFTER the deny rules — the last matching
# section wins for Require in Apache 2.4)
<Files "manifest.json">
  Require all granted
</Files>
