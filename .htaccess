# ═══════════════════════════════════════════════════════════
#  GLORIKAR — root .htaccess (production reference)
# ═══════════════════════════════════════════════════════════

ServerName glorikar-engineering.onrender.com

Options -Indexes
ServerSignature Off

# Allow the PWA manifest (the generic .json deny rule below would otherwise block it)
<Files "manifest.json">
  Require all granted
</Files>

# Never serve sensitive / internal files directly
<FilesMatch "\.(env|sql|log|json|md|gitignore|lock)$">
  Require all denied
</FilesMatch>

<FilesMatch "composer\.(json|lock)$">
  Require all denied
</FilesMatch>
