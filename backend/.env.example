# Glorikar Engineering — backend environment
# NEVER commit this file. Copy .env.example and fill in real values.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=glorikar
DB_USER=root
DB_PASS=

JWT_SECRET=change-me-to-a-long-random-string
MAPBOX_ACCESS_TOKEN=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Email (Gmail app password) — used for outbound notifications
EMAIL_USER=
EMAIL_APP_PASSWORD=

# Canonical public base URL for outbound links (password reset).
# Leave empty on localhost; set in production (e.g. https://glorikar.example.com)
# so links can't be rewritten via a forged Host header.
RESET_LINK_BASE=

DEPOT_LAT=14.300078442310024
DEPOT_LNG=120.97451385971915
MIN_TRIP_SCORE=10
MAX_DAILY_HOURS=8
# Canonical origin for pages (used for redirects + outbound links when
# RESET_LINK_BASE is empty). Empty = same origin as the request.
APP_URL=
API_URL=
ALLOWED_ORIGINS=

# CSRF / session
COOKIE_SECURE=false
SESSION_LIFETIME=1800

# Rate limiting (attempts per window per IP). 5/900 = 5 per 15 min.
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW=900

# File uploads
UPLOAD_MAX_BYTES=5242880
UPLOAD_DIR=../uploads