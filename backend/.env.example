# ═══════════════════════════════════════════════════════════
#  GLORIKAR — backend/.env.example
#  Copy to .env on the server and fill in real values.
#  Never commit .env itself; keep .env in .gitignore.
# ═══════════════════════════════════════════════════════════

# ── Database (MySQL) ─────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=glorikar
DB_USER=glorikar_app
DB_PASS=change_me
# Path/gate for the Aiven CA certificate (backend/aiven-ca.pem).
# Set to any non-empty value (e.g. 1) to enable MySQL SSL — required on Aiven,
# leave unset/empty for local XAMPP (plain TCP).
DB_SSL_CA=

# ── Auth ─────────────────────────────────────────────────
# Generate: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=replace_with_64_char_hex_string

# ── Mapbox ───────────────────────────────────────────────
MAPBOX_ACCESS_TOKEN=pk.your_mapbox_public_token

# ── Web Push (VAPID) ─────────────────────────────────────
# Generate: see DEPLOY.md §7 (vendor/bin/vapid-generate-keys or the PHP one-liner)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── Scheduling ───────────────────────────────────────────
# Depot = your office/home base GPS coords (Dasmariñas, Cavite)
DEPOT_LAT=14.3294
DEPOT_LNG=120.9367
MIN_TRIP_SCORE=10
MAX_DAILY_HOURS=8
