# ============================================================
# frontend/.htaccess.example — copy to frontend/.htaccess
# when deploying under Apache. The built-in PHP dev server
# (php -S localhost:8000 dev-router.php) ignores this file.
# ============================================================

Options -Indexes

# PHP handler for the server-rendered pages.
<FilesMatch "\.php$">
    SetHandler application/x-httpd-php
</FilesMatch>

# Force HTTPS in production (uncomment).
# RewriteEngine On
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# Service worker must be served from the site root with no-store.
<Files "sw.js">
    Header set Cache-Control "no-store"
</Files>

# Cache static assets aggressively.
<FilesMatch "\.(css|js|png|jpg|jpeg|webp|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

# Block direct access to sensitive files.
<FilesMatch "^\.(env|git)" Order allow,deny Deny from all